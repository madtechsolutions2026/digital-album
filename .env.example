# Database Configuration
# PostgreSQL database URL with asyncpg driver. The database must have the
# pgvector extension enabled (see SETUP.md).
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/wedding_photos
ADMIN_USERNAME=photographer
ADMIN_PASSWORD=replace-with-a-strong-random-password
JWT_SECRET=replace-with-a-strong-random-signing-key

# Storage Configuration
# STORAGE_TYPE: "local" (filesystem) or "r2" (Cloudflare R2 / S3-compatible)
STORAGE_TYPE=local

# Used when STORAGE_TYPE=local. Base directory for storing uploaded images.
STORAGE_PATH=./storage

# Cloudflare R2 Configuration (required only when STORAGE_TYPE=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional: public URL for the bucket (e.g. https://pub-xxxx.r2.dev). If
# omitted, a default R2.dev URL is derived from R2_ACCOUNT_ID.
R2_PUBLIC_URL=

# Image Validation Limits
# Maximum file size in bytes (default: 10MB = 10485760)
MAX_FILE_SIZE=10485760

# Maximum image dimension in pixels (default: 8000)
MAX_DIMENSION=8000

# Images larger than this will be resized before face detection (default: 2048)
RESIZE_THRESHOLD=2048

# Face recognition settings.  Keep the model unchanged while existing
# embeddings are in use; buffalo_s and buffalo_l embeddings must not be mixed.
INSIGHTFACE_MODEL=buffalo_s
FACE_DETECTION_SIZE=640
FACE_MIN_DETECTION_CONFIDENCE=0.50
FACE_MIN_SIZE=24
SELFIE_MIN_FACE_SIZE=80
SELFIE_MAX_COMPETING_FACE_RATIO=0.70
DEFAULT_SIMILARITY_THRESHOLD=0.60
MAX_SEARCH_RESULTS=100

# Max photos processed (validate/compress/upload) at once, across all
# requests. Bounds CPU/memory under a large batch upload; the rest queue.
MAX_CONCURRENT_UPLOADS=8

# CORS Configuration
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging Configuration
# Valid levels: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Application Mode
# Set to True to enable debug mode (verbose logging, SQLAlchemy echo, uvicorn --reload)
DEBUG=True
