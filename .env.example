# Database Configuration
# PostgreSQL database URL with asyncpg driver. The database must have the
# pgvector extension enabled (see SETUP.md).
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/wedding_photos
ADMIN_USERNAME=photographer
ADMIN_PASSWORD=replace-with-a-strong-random-password
JWT_SECRET=replace-with-a-strong-random-signing-key

# Storage Configuration
# STORAGE_TYPE: "local" (filesystem) or "r2" (Cloudflare R2) or "s3" (AWS S3)
STORAGE_TYPE=local

# Used when STORAGE_TYPE=local. Base directory for storing uploaded images.
STORAGE_PATH=./storage

# ============================================================================
# AWS Rekognition & S3 Production Face AI Configuration
# Commercially licensed precision face matching & private wedding photo storage
# ============================================================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=dg-album-photos
AWS_REKOGNITION_COLLECTION_ID=dg-album-production

# Face matching confidence thresholds:
# 1. High confidence (>= 85%): Auto-confirmed and sent to guest gallery
# 2. Medium confidence (60% - 84.9%): Routed to studio manual review queue
# 3. Low confidence (< 60%): Rejected to prevent false positives
REKOGNITION_HIGH_CONFIDENCE_THRESHOLD=85.0
REKOGNITION_REVIEW_CONFIDENCE_THRESHOLD=60.0

# Cloudflare R2 Configuration (required only when STORAGE_TYPE=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Image Validation Limits
MAX_FILE_SIZE=10485760
MAX_DIMENSION=8000
RESIZE_THRESHOLD=2048

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:4179

# Logging Configuration
LOG_LEVEL=INFO

# Application Mode
DEBUG=True
