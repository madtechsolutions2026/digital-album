# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/wedding_photos

# Storage Configuration
STORAGE_PATH=/app/storage/photos
STORAGE_TYPE=local  # 'local' or 'r2'

# Cloudflare R2 Configuration (only needed if STORAGE_TYPE=r2)
R2_ACCOUNT_ID=your_account_id_here
R2_ACCESS_KEY_ID=your_access_key_here
R2_SECRET_ACCESS_KEY=your_secret_key_here
R2_BUCKET_NAME=wedding-photos
R2_PUBLIC_URL=  # Optional: Custom domain URL

# Application Configuration
DEBUG=false
LOG_LEVEL=INFO

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Redis Configuration (for Celery background jobs)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Database Connection Pool Settings (optional)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# Image Processing Limits
MAX_FILE_SIZE_MB=10
MAX_IMAGE_DIMENSION=8000
RESIZE_THRESHOLD=2048

# Face Recognition Settings
# Keep this aligned with the model used to create existing embeddings.  The
# model packs are not interchangeable; switching requires re-indexing photos.
INSIGHTFACE_MODEL=buffalo_s
FACE_DETECTION_SIZE=640
FACE_MIN_DETECTION_CONFIDENCE=0.50
FACE_MIN_SIZE=24
SELFIE_MIN_FACE_SIZE=80
SELFIE_MAX_COMPETING_FACE_RATIO=0.70
DEFAULT_SIMILARITY_THRESHOLD=0.60
MAX_SEARCH_RESULTS=100

# API Settings
MAX_SEARCH_RESULTS=100
DEFAULT_SIMILARITY_THRESHOLD=0.6
